---
import Layout from "../../layouts/Layout.astro";
import { CITIES, getCity } from "../../lib/cities";

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug } }));
}

const { city: slug } = Astro.params;
const city = getCity(slug!);

if (!city) {
  return Astro.redirect("/404");
}

const title = `Food Truck Permit in ${city.name}, ${city.state} — Requirements, Fees & Process`;
const description = `How to get a food truck permit in ${city.name}, ${city.state}. ${city.agency}. Fees ${city.feeRange}. Processing ${city.processingTime}.`;
const url = `/food-truck-permits/${slug}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  about: `Food truck permits in ${city.name}, ${city.state}`,
  mainEntityOfPage: url,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "/" },
    { "@type": "ListItem", position: 2, name: "Food Truck Permits", item: "/" },
    { "@type": "ListItem", position: 3, name: `${city.name}, ${city.state}`, item: url },
  ],
};
---
<Layout title={title} description={description} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
        <a href="/" class="font-semibold">Food Truck Permits</a>
        <a href="/app" class="rounded-md bg-primary px-3 py-1.5 text-sm text-primary-foreground hover:bg-primary/90">
          Track my permit
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-12">
      <nav class="mb-6 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground">Home</a>
        <span class="mx-2">/</span>
        <span>{city.name}, {city.state}</span>
      </nav>

      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Food Truck Permit in {city.name}, {city.state}
      </h1>
      <p class="mt-4 text-lg text-muted-foreground">
        What you need to operate a mobile food unit in {city.name}, including the
        issuing agency, typical fees, and renewal cadence.
      </p>

      <dl class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-border bg-card p-4">
          <dt class="text-xs uppercase tracking-wide text-muted-foreground">Issuing agency</dt>
          <dd class="mt-1 font-medium">{city.agency}</dd>
        </div>
        <div class="rounded-lg border border-border bg-card p-4">
          <dt class="text-xs uppercase tracking-wide text-muted-foreground">Fees</dt>
          <dd class="mt-1 font-medium">{city.feeRange}</dd>
        </div>
        <div class="rounded-lg border border-border bg-card p-4">
          <dt class="text-xs uppercase tracking-wide text-muted-foreground">Processing time</dt>
          <dd class="mt-1 font-medium">{city.processingTime}</dd>
        </div>
        <div class="rounded-lg border border-border bg-card p-4">
          <dt class="text-xs uppercase tracking-wide text-muted-foreground">Renewal</dt>
          <dd class="mt-1 font-medium">{city.renewal}</dd>
        </div>
      </dl>

      <section class="mt-10">
        <h2 class="text-xl font-semibold">What to know</h2>
        <p class="mt-3 text-muted-foreground">{city.notes}</p>
      </section>

      <section class="mt-10 rounded-lg border border-border bg-card p-6">
        <h2 class="text-lg font-semibold">Don't lose track of your renewal</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Log your {city.name} permit and we'll keep its expiration date front and center.
        </p>
        <a
          href="/app/permits/new"
          class="mt-4 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Add my permit
        </a>
      </section>

      <section class="mt-12">
        <h2 class="text-lg font-semibold">Other cities</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {CITIES.filter((c) => c.slug !== city.slug).map((c) => (
            <li>
              <a
                href={`/food-truck-permits/${c.slug}`}
                class="rounded-full border border-border px-3 py-1 text-sm hover:border-primary"
              >
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto max-w-3xl px-6 py-8 text-sm text-muted-foreground">
        This guide is informational and not legal advice. Verify requirements with {city.agency}.
      </div>
    </footer>
  </div>
</Layout>
